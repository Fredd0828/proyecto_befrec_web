# ============================================
# BEFREC Y ASOCIADOS - Configuracion Apache
# ============================================

Options -Indexes
ServerSignature Off
DirectoryIndex index.html

ErrorDocument 404 /404.html

RewriteEngine On
RewriteBase /

# ── 1. Forzar HTTPS ──────────────────────────
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# ── 2. Forzar www ────────────────────────────
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [L,R=301]

# ── 3. Redirigir /index(.html) → / ───────────
RewriteRule ^index\.html?$ / [L,R=301]

# ── 4. Eliminar .html publico (canonical URL) ─
RewriteCond %{THE_REQUEST} \s/+([^\s]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [L,R=301]

# ── 5. Paginas que comparten nombre con carpeta ─
# /blog, /servicios, /negocios, /personas deben servir el .html del root
RewriteRule ^blog/?$       /blog.html       [L]
RewriteRule ^servicios/?$  /servicios.html  [L]
RewriteRule ^negocios/?$   /negocios.html   [L]
RewriteRule ^personas/?$   /personas.html   [L]

# ── 6. URL limpia → archivo .html ────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# ============================================
# Proteccion de archivos sensibles
# ============================================
<FilesMatch "^(\.env|\.git|\.htaccess|\.htpasswd|config\.php|setup-db\.sql)">
    Require all denied
</FilesMatch>

# ============================================
# Cabeceras de seguridad
# ============================================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ============================================
# Cache para recursos estaticos
# ============================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                       "access plus 1 month"
    ExpiresByType text/html              "access plus 0 seconds"
    ExpiresByType text/css               "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/webp             "access plus 1 year"
    ExpiresByType image/jpeg             "access plus 1 year"
    ExpiresByType image/png              "access plus 1 year"
    ExpiresByType image/svg+xml          "access plus 1 year"
    ExpiresByType font/woff2             "access plus 1 year"
    ExpiresByType font/ttf               "access plus 1 year"
</IfModule>

# ============================================
# Compresion GZIP
# ============================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
